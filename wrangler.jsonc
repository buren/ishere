/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ishere-v2",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",

	// Logs
	"observability": {
		"enabled": true
	},

	// Dev configuration
  "vars": {
    "ENVIRONMENT": "development",
    "ACCOUNT_ID": "5fa4ed4d2fd86702c5bb6cb04e0b5b36"
  },

  "routes": [
    { "pattern": "dev.wshr.io", "custom_domain": true }
  ],

  "kv_namespaces": [
    { "binding": "KV", "id": "de121ffb1f654596a2ac2857b57b1a65", "preview_id": "f463e85382724a1f889bd660074e3ad9" }
  ],

  "d1_databases": [
    { "binding": "D1", "database_name": "ishere", "database_id": "a08d3c3a-b282-4e7b-900a-bb6eebdd83b5" }
  ],

  "analytics_engine_datasets": [
    { "binding": "REDIRECTS_DEV" }
  ],

  "triggers": {
    "crons": [ "0 * * * *" ]
  },

  // Production configuration
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "ACCOUNT_ID": "5fa4ed4d2fd86702c5bb6cb04e0b5b36"
      },

      "routes": [
        { "pattern": "wshr.io", "custom_domain": true }
      ],

      "kv_namespaces": [
        { "binding": "KV", "id": "53632936b4f94ca6be48a1ada0ec350f" }
      ],

      "d1_databases": [
        { "binding": "D1", "database_name": "ishere-production", "database_id": "456f1e34-f0af-48c1-b361-a3fac293ffa0" }
      ],

      "analytics_engine_datasets": [
        { "binding": "REDIRECTS" }
      ],

      "triggers": {
        "crons": [ "0 * * * *" ]
      }
    }
  }
}
