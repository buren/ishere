/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ishere-v2",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",

	// Logs
	"observability": {
		"enabled": true
	},

	// Dev configuration
  "vars": {
    "ENVIRONMENT": "development",
    "ACCOUNT_ID": "TODO"
  },

  // "routes": [
  //   { "pattern": "dev.wshr.io", "custom_domain": true }
  // ],

  "kv_namespaces": [
    { "binding": "KV", "id": "TODO", "preview_id": "TODO" }
  ],

  "d1_databases": [
    { "binding": "D1", "database_name": "ishere", "database_id": "TODO" }
  ],

  "analytics_engine_datasets": [
    { "binding": "REDIRECTS_DEV" }
  ],

  "triggers": {
    "crons": [ "0 * * * *" ]
  },

  // Production configuration
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "ACCOUNT_ID": "TODO"
      },

      "routes": [
        { "pattern": "wshr.io", "custom_domain": true }
      ],

      "kv_namespaces": [
        { "binding": "KV", "id": "TODO" }
      ],

      "d1_databases": [
        { "binding": "D1", "database_name": "ishere-production", "database_id": "TODO" }
      ],

      "analytics_engine_datasets": [
        { "binding": "REDIRECTS" }
      ],

      "triggers": {
        "crons": [ "0 * * * *" ]
      }
    }
  }
}
